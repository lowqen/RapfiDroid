+#ifdef USE_NEON_I8MM
+        /// forwardMulti with ARMv8.6 I8MM. smmla multiplies a 2x8 int8 block (two inputs, eight input
+        /// lanes) by a 2x8 block (two outputs' weights over the same lanes) into a 2x2 int32 block:
+        /// 32 MACs per instruction against sdot's 16. The weight layout is unchanged — two consecutive
+        /// chunks of four outputs, zipped by 32-bit lane, are the 2x8 rows of two output pairs.
+        /// Unsigned 7-bit inputs are valid int8, so one signed path serves both input kinds. Int32 sums
+        /// are exact, so adding the bias last and the different order give the bits of forward().
+        template <int N, bool Bias, bool PreReLU, bool PostReLU>
+        static void forwardMultiMmla(int32_t *const      output[N],
+                                     const int8_t *const input[N],
+                                     const int8_t       *weight,
+                                     const int32_t      *bias)
+        {
+            typedef VecBatch<OutSize, int32_t, I> OutB;
+            constexpr int Pairs = N / 2;
+            // Groups of four outputs per tile: Pairs x Groups x 2 accumulators + Groups x 2 weight
+            // blocks + one input block stay within the 32 vector registers for N = 4.
+            constexpr int Groups = OutB::NumBatch % 4 == 0 ? 4 : OutB::NumBatch % 2 == 0 ? 2 : 1;
+            constexpr int ChunkBytes = OutSize * ChunkSize;
+
+            for (int t = 0; t < OutB::NumBatch; t += Groups) {
+                // acc[p][g][h] lanes: (in 2p, out 2h), (in 2p, out 2h+1), (in 2p+1, out 2h), (in 2p+1, out 2h+1)
+                // of the four outputs in group t + g.
+                int32x4_t acc[Pairs][Groups][2];
+                for (int p = 0; p < Pairs; p++)
+                    for (int g = 0; g < Groups; g++)
+                        acc[p][g][0] = acc[p][g][1] = vdupq_n_s32(0);
+
+                for (int i = 0; i < NumChunks; i += 2) {
+                    const int8_t *c0 = weight + i * ChunkBytes;
+                    const int8_t *c1 = c0 + ChunkBytes;
+                    int8x16_t     w[Groups][2];
+                    for (int g = 0; g < Groups; g++) {
+                        int32x4_t w0 = vreinterpretq_s32_s8(vld1q_s8(c0 + (t + g) * 16));
+                        int32x4_t w1 = vreinterpretq_s32_s8(vld1q_s8(c1 + (t + g) * 16));
+                        w[g][0] = vreinterpretq_s8_s32(vzip1q_s32(w0, w1));  // outputs 0, 1
+                        w[g][1] = vreinterpretq_s8_s32(vzip2q_s32(w0, w1));  // outputs 2, 3
+                    }
+
+                    for (int p = 0; p < Pairs; p++) {
+                        int8x16_t a = vcombine_s8(vld1_s8(input[2 * p] + i * ChunkSize),
+                                                  vld1_s8(input[2 * p + 1] + i * ChunkSize));
+                        if constexpr (PreReLU)
+                            a = vmaxq_s8(a, vdupq_n_s8(0));
+                        for (int g = 0; g < Groups; g++) {
+                            acc[p][g][0] = vmmlaq_s32(acc[p][g][0], a, w[g][0]);
+                            acc[p][g][1] = vmmlaq_s32(acc[p][g][1], a, w[g][1]);
+                        }
+                    }
+                }
+
+                for (int p = 0; p < Pairs; p++)
+                    for (int g = 0; g < Groups; g++) {
+                        int64x2_t lo = vreinterpretq_s64_s32(acc[p][g][0]);
+                        int64x2_t hi = vreinterpretq_s64_s32(acc[p][g][1]);
+                        int32x4_t v[2] = {vreinterpretq_s32_s64(vzip1q_s64(lo, hi)),   // input 2p
+                                          vreinterpretq_s32_s64(vzip2q_s64(lo, hi))};  // input 2p+1
+                        for (int h = 0; h < 2; h++) {
+                            if constexpr (Bias)
+                                v[h] = vaddq_s32(v[h], vld1q_s32(bias + (t + g) * 4));
+                            if constexpr (PostReLU)
+                                v[h] = vmaxq_s32(v[h], vdupq_n_s32(0));
+                            vst1q_s32(output[2 * p + h] + (t + g) * 4, v[h]);
+                        }
+                    }
+            }
+        }
+#endif
     };
 
