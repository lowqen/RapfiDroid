+/// [A4] Policy result cache. Each cell's policy output depends only on the accumulator of the
+/// position (an exact function of the stones) and the global features, never on which other cells
+/// are flagged, so returning stored outputs for the same position is bit-exact. An entry is used
+/// only when every requested cell was computed before; otherwise the policy is recomputed and the
+/// new cells are merged in. One cache per evaluator (= per search thread), no locking.
+struct PolicyCache
+{
+    static constexpr int    LogEntries = 12;  // 4096 entries, ~3.9 MB at 15x15
+    static constexpr size_t NumEntries = size_t(1) << LogEntries;
+
+    explicit PolicyCache(int numCells)
+        : numCells(numCells)
+        , numWords((numCells + 63) / 64)
+        , keys(NumEntries, 0)
+        , plies(NumEntries, -1)
+        , flags(NumEntries * numWords, 0)
+        , values(NumEntries * numCells)
+    {}
+
+    /// Fill the requested cells of the buffer if all of them are stored for this position.
+    bool read(HashKey key, int ply, PolicyBuffer &buffer) const
+    {
+        size_t e = key & (NumEntries - 1);
+        if (keys[e] != key || plies[e] != ply)
+            return false;
+
+        const uint64_t *f = &flags[e * numWords];
+        for (int i = 0; i < numCells; i++)
+            if (buffer.getComputeFlag(i) && !((f[i >> 6] >> (i & 63)) & 1))
+                return false;
+
+        const float *v = &values[e * numCells];
+        for (int i = 0; i < numCells; i++)
+            if (buffer.getComputeFlag(i))
+                buffer(i) = v[i];
+        return true;
+    }
+
+    /// Store the requested cells of a freshly computed buffer.
+    void write(HashKey key, int ply, const PolicyBuffer &buffer)
+    {
+        size_t    e = key & (NumEntries - 1);
+        uint64_t *f = &flags[e * numWords];
+        if (keys[e] != key || plies[e] != ply) {
+            keys[e]  = key;
+            plies[e] = ply;
+            std::fill_n(f, numWords, uint64_t(0));
+        }
+
+        float *v = &values[e * numCells];
+        for (int i = 0; i < numCells; i++)
+            if (buffer.getComputeFlag(i)) {
+                f[i >> 6] |= uint64_t(1) << (i & 63);
+                v[i] = buffer(i);
+            }
+    }
+
+private:
+    int                   numCells, numWords;
+    std::vector<HashKey>  keys;
+    std::vector<int>      plies;
+    std::vector<uint64_t> flags;
+    std::vector<float>    values;
+};
