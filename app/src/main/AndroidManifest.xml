<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The engine socket connects to the Rapfi server over the device's
         system Tailscale VPN. No location/storage needed for P1. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ZenythApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zenyth">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Zenyth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- RapfiWeb position links (…/board?p=h8i9j10). Not auto-verified:
                 the user can choose this app for them in the system settings. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rapfiweb.pages.dev" />
            </intent-filter>
        </activity>

        <!-- specialUse on Android 14+ (T2): an engine session — an open-ended analysis
             the user is watching, or a link to the server — has no fixed end, and
             dataSync gets six hours a day and an onTimeout on Android 15. Below 14
             the service starts as dataSync, which has no such limit there. -->
        <service
            android:name=".data.engine.EngineService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started game engine session (on-device Rapfi search or the link to the user's own engine server) running while its result is shown in an ongoing notification." />
        </service>

        <!-- Building the opening packs from a .rif takes minutes and must
             survive the screen going off; nothing here touches the network. -->
        <service
            android:name=".data.rif.PackBuildService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
