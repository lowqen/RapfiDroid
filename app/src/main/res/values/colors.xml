<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launch window, before Compose draws anything.

      These have to match the Compose theme's `surface` exactly, or the first
      frame of every launch is a flash of the wrong colour. They used to be one
      value — the dark one — with no `values-night` beside it, so a light-theme
      user watched the app open black every single time.

      Kept in step with `Theme.kt`: Neutral tone 98 (light) / tone 12 (dark).
    -->
    <color name="launch_background">#FCF9F4</color>

    <!--
      The disc the Android 12+ splash screen paints behind the launcher icon.
      The icon is an opaque photograph, so this only shows along the disc's
      antialiased rim — it matches the photograph's own ground (#060504) so the
      rim reads as part of the icon. Unlike `launch_background` it is a property
      of the artwork, not of the theme, so there is no `values-night` twin.
    -->
    <color name="launch_icon_background">#060504</color>
</resources>
