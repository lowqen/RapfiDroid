<?xml version="1.0" encoding="utf-8"?>
<!--
  The two languages this app supports. Android 13+ reads this to offer a
  per-app language picker in system settings; below 13 the app follows the
  system locale and falls back to English for anything that is not Korean.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ko" />
    <locale android:name="en" />
</locale-config>
