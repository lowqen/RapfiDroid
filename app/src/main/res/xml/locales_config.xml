<?xml version="1.0" encoding="utf-8"?>
<!--
  The three languages this app supports. Android 13+ reads this to offer a
  per-app language picker in system settings; below 13 the app follows the
  system locale: Korean, Chinese (Simplified, for any zh locale), and English
  for everything else.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ko" />
    <locale android:name="en" />
    <locale android:name="zh-CN" />
</locale-config>
