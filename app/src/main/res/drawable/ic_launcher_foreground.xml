<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: three lines each way and two stones, all inside the
  66dp safe square (21..87) that every launcher mask keeps.

  The icon this replaces drew a full 108dp board with a nine-line grid, which is
  the mistake most first icons make: at 48dp on a home screen those lines are a
  grey texture and the two stones are specks. A launcher icon is read at the
  size of a fingernail, so it carries one idea — *stones on a board* — at the
  largest size that fits.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- grid: 3x3, spacing 21, from 33 to 75 -->
    <path
        android:strokeColor="#7E5D14"
        android:strokeWidth="2.6"
        android:strokeAlpha="0.9"
        android:pathData="M33,33 h42 M33,54 h42 M33,75 h42 M33,33 v42 M54,33 v42 M75,33 v42" />

    <!-- white stone, top right -->
    <path
        android:fillColor="#FFFCF7"
        android:strokeColor="#AE8B48"
        android:strokeWidth="1.6"
        android:pathData="M75,33 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0" />

    <!-- black stone, on the centre point -->
    <path
        android:fillColor="#191209"
        android:pathData="M54,54 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0" />
</vector>
