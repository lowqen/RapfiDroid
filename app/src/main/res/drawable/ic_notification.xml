<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon. Android masks a notification icon down to its alpha channel
  and paints it white, so this is a silhouette by design, drawn at 24dp rather
  than being the launcher icon shrunk — which is what it used to be, and why the
  board came through as a grey smudge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.75"
        android:pathData="M4,12 h16 M12,4 v16" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,12 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
</vector>
