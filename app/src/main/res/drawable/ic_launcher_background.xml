<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: the dark ground the foreground photograph sits on.

  The foreground is an opaque 108dp bitmap, so this layer is only ever seen
  through the gap a launcher's parallax opens at the edges. Matching the
  photograph's own corners (#060504) makes that gap invisible; a contrasting
  colour here — the wood gold this used to be — would flash a bright rim
  whenever the icon was tilted.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#060504"
        android:pathData="M0,0h108v108h-108z" />
</vector>
