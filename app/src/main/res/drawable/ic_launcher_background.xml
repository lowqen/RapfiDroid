<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: the board's wood, as the light theme paints it
  (`BoardSkin.Light` — Clay tone 76 falling to tone 68). The launcher masks this
  layer to whatever shape the device uses, so it carries no detail at all: every
  line and stone lives in the foreground, inside the 66dp safe circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#DAB673" />
                <item android:offset="1" android:color="#C4A05E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
